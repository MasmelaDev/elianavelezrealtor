---
import BaseLayout from '../../../components/layout/BaseLayout.astro'
import PublicLayout from '../../../components/layout/PublicLayout.astro'
import { useTranslations } from '../../../i18n/utils'
import { db } from '../../../lib/db'
import { properties } from '../../../db/schema'
import { eq, desc, and } from 'drizzle-orm'
const t = useTranslations('es')
const url = Astro.url
const zone = url.searchParams.get('zone')
const type = url.searchParams.get('type')
const conditions = [eq(properties.status, 'available')]
if (zone) conditions.push(eq(properties.zone, zone))
if (type) conditions.push(eq(properties.type, type))
const whereClause = and(...conditions)
import { PropertyGrid } from '../../../components/properties/PropertyGrid'
const [list] = await Promise.all([
  db.select().from(properties).where(whereClause).orderBy(desc(properties.createdAt))
])
---
<BaseLayout title="Propiedades" description="Propiedades disponibles" lang="es">
  <PublicLayout lang="es" t={t}>
    <div class="mx-auto max-w-7xl px-4 py-8">
      <h1 class="text-2xl font-bold text-gray-900 mb-6">{t('properties.title')}</h1>
      
      <PropertyGrid 
        client:load 
        initialProperties={list as any} 
        lang="es" 
        initialZone={zone ?? ''}
        initialType={type ?? ''}
      />
    </div>
  </PublicLayout>
</BaseLayout>
