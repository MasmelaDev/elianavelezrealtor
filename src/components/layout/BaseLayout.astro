---
import '../../styles/global.css'
import favicon from '../../assets/favicon.svg'
interface Props {
  title: string
  description: string
  image?: string
  lang: string
}
const { title, description, image, lang } = Astro.props
const canonical = new URL(Astro.url.pathname, import.meta.env.PUBLIC_SITE_URL || Astro.url.origin)
---
<html lang={lang} class="font-sans antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image ?? '/og-default.jpg'} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="alternate" hreflang="en" href={`${import.meta.env.PUBLIC_SITE_URL || Astro.url.origin}/en${Astro.url.pathname.replace(/^\/(en|es)/, '') || ''}`} />
    <link rel="alternate" hreflang="es" href={`${import.meta.env.PUBLIC_SITE_URL || Astro.url.origin}/es${Astro.url.pathname.replace(/^\/(en|es)/, '') || ''}`} />
    <link rel="alternate" hreflang="x-default" href={`${import.meta.env.PUBLIC_SITE_URL || Astro.url.origin}/en`} />
  </head>
  <body class="bg-surface text-on-surface">
    <slot />
  </body>
</html>
