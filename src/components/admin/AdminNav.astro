---
const currentPath = Astro.url.pathname

function isActive(href: string): boolean {
  if (href === '/admin') return currentPath === '/admin' || currentPath === '/admin/'
  return currentPath.startsWith(href)
}

interface NavItem {
  href: string
  label: string
  icon: string
}

interface NavGroup {
  title: string
  items: NavItem[]
}

const navGroups: NavGroup[] = [
  {
    title: 'General',
    items: [
      { href: '/admin', label: 'Dashboard', icon: 'dashboard' },
      { href: '/admin/preview', label: 'Editar Página', icon: 'edit-page' },
      { href: '/admin/settings', label: 'Configuración', icon: 'settings' },
    ],
  },
  {
    title: 'Contenido',
    items: [
      { href: '/admin/properties', label: 'Propiedades', icon: 'properties' },
      { href: '/admin/blog', label: 'Blog', icon: 'blog' },
    ],
  },
  {
    title: 'CRM',
    items: [
      { href: '/admin/leads', label: 'Leads', icon: 'leads' },
      { href: '/admin/appointments', label: 'Citas', icon: 'appointments' },
      { href: '/admin/availability', label: 'Disponibilidad', icon: 'availability' },
    ],
  },
]
---

<!-- Mobile Toggle Button -->
<button
  id="sidebar-toggle"
  class="fixed top-4 left-4 z-[70] flex h-10 w-10 items-center justify-center rounded-lg bg-[#0F2A3D] text-white shadow-lg lg:hidden"
  aria-label="Toggle sidebar"
>
  <svg id="toggle-open" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
  </svg>
  <svg id="toggle-close" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
  </svg>
</button>

<!-- Overlay (mobile) -->
<div id="sidebar-overlay" class="fixed inset-0 z-[55] hidden bg-black/40 backdrop-blur-sm lg:hidden transition-opacity"></div>

<!-- Sidebar -->
<aside
  id="admin-sidebar"
  class="fixed top-0 left-0 z-[60] flex h-full w-[260px] -translate-x-full flex-col bg-[#0F2A3D] text-white transition-transform duration-300 ease-in-out lg:translate-x-0"
>
  <!-- Logo / Brand -->
  <div class="flex h-16 items-center gap-3 border-b border-white/10 px-5">
    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-white/10">
      <svg class="h-5 w-5 text-[#B8860B]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
    </div>
    <div>
      <p class="text-sm font-semibold tracking-wide">Eliana Admin</p>
      <p class="text-[10px] uppercase tracking-widest text-white/40">Panel de gestión</p>
    </div>
  </div>

  <!-- Navigation Groups -->
  <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-6">
    {navGroups.map((group) => (
      <div>
        <p class="mb-2 px-3 text-[10px] font-bold uppercase tracking-[0.15em] text-white/30">
          {group.title}
        </p>
        <ul class="space-y-0.5">
          {group.items.map((item) => {
            const active = isActive(item.href)
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'group flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-all duration-200',
                    active
                      ? 'bg-white/15 text-white shadow-sm'
                      : 'text-white/60 hover:bg-white/8 hover:text-white/90',
                  ]}
                >
                  <!-- Icon -->
                  <span
                    class:list={[
                      'flex h-8 w-8 items-center justify-center rounded-md transition-colors',
                      active ? 'bg-[#B8860B] text-white' : 'bg-white/8 text-white/50 group-hover:bg-white/12 group-hover:text-white/80',
                    ]}
                  >
                    {item.icon === 'dashboard' && (
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v5a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v2a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-3zM14 13a1 1 0 011-1h4a1 1 0 011 1v6a1 1 0 01-1 1h-4a1 1 0 01-1-1v-6z" /></svg>
                    )}
                    {item.icon === 'edit-page' && (
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                    )}
                    {item.icon === 'settings' && (
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                    )}
                    {item.icon === 'properties' && (
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                    )}
                    {item.icon === 'blog' && (
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
                    )}
                    {item.icon === 'leads' && (
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                    )}
                    {item.icon === 'appointments' && (
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                    )}
                    {item.icon === 'availability' && (
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    )}
                  </span>

                  <span>{item.label}</span>

                  {active && (
                    <span class="ml-auto h-1.5 w-1.5 rounded-full bg-[#B8860B]"></span>
                  )}
                </a>
              </li>
            )
          })}
        </ul>
      </div>
    ))}
  </nav>

  <!-- Footer: View Site + Logout -->
  <div class="border-t border-white/10 p-3 space-y-1">
    <a
      href="/"
      target="_blank"
      class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-white/50 transition-colors hover:bg-white/8 hover:text-white/80"
    >
      <span class="flex h-8 w-8 items-center justify-center rounded-md bg-white/8">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
      </span>
      <span>Ver Sitio</span>
    </a>
    <form method="post" action="/api/auth/logout">
      <button
        type="submit"
        class="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-red-400/70 transition-colors hover:bg-red-500/10 hover:text-red-400"
      >
        <span class="flex h-8 w-8 items-center justify-center rounded-md bg-white/8">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
        </span>
        <span>Cerrar Sesión</span>
      </button>
    </form>
  </div>
</aside>

<script>
  const toggle = document.getElementById('sidebar-toggle')!
  const sidebar = document.getElementById('admin-sidebar')!
  const overlay = document.getElementById('sidebar-overlay')!
  const iconOpen = document.getElementById('toggle-open')!
  const iconClose = document.getElementById('toggle-close')!

  let isOpen = false

  function toggleSidebar() {
    isOpen = !isOpen
    sidebar.classList.toggle('-translate-x-full', !isOpen)
    overlay.classList.toggle('hidden', !isOpen)
    iconOpen.classList.toggle('hidden', isOpen)
    iconClose.classList.toggle('hidden', !isOpen)
  }

  toggle.addEventListener('click', toggleSidebar)
  overlay.addEventListener('click', toggleSidebar)
</script>
