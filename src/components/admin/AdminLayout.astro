---
import '../../styles/global.css'
import AdminNav from './AdminNav.astro'
import favicon from '../../assets/favicon.svg'
interface Props {
  title: string
  fullBleed?: boolean
}
const { title, fullBleed = false } = Astro.props
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | Admin</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      body { font-family: 'Inter', system-ui, -apple-system, sans-serif; }
    </style>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <AdminNav />

    <!-- Main Content Area (offset by sidebar) -->
    <div class="lg:pl-[260px] min-h-screen transition-all duration-300">
      {/* Top bar for page context */}
      <header class="sticky top-0 z-40 flex h-16 items-center border-b border-gray-200 bg-white/80 backdrop-blur-md px-6">
        <div class="flex items-center gap-3">
          <h1 class="text-lg font-semibold text-gray-900">{title}</h1>
        </div>
      </header>

      <main class:list={[
        fullBleed ? '' : 'mx-auto max-w-7xl px-6 py-6'
      ]}>
        <slot />
      </main>
    </div>
  </body>
</html>
