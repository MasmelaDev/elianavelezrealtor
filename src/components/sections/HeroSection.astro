---
import { getRelativeLocaleUrl } from '../../i18n/utils'
import type { Lang } from '../../i18n/ui'
import type { UIKey } from '../../i18n/ui'
import { HeroContent } from './HeroContent'

interface Props {
  lang: Lang
  t: (key: UIKey) => string
  title: string
  subtitle: string
  heroImage?: string
  tagline?: string
  role?: string
  primaryCta?: string
  secondaryCta?: string
  badgeTitle?: string
  badgeDesc?: string
}
const { lang, t, title, subtitle, heroImage = '/images/elianafull.jpg', tagline = t('hero.tagline'), role = t('hero.role'), primaryCta = t('hero.cta.primary'), secondaryCta = t('hero.cta.secondary'), badgeTitle = t('hero.badgeTitle'), badgeDesc = t('hero.badgeDesc') } = Astro.props
---

<section class="hero-section relative w-full min-h-[100dvh] overflow-hidden bg-surface-dark" aria-label="Hero">

  {/* ── Left: Eliana Portrait ── */}
  <div class="absolute inset-0 lg:w-[50%] pointer-events-none" aria-hidden="true" data-edit-key="image.hero">
    <img
      src={heroImage}
      alt=""
      class="h-full w-full object-cover object-top"
    />
    {/* Gradient overlays for text readability */}
    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-surface-dark/40 to-surface-dark lg:via-surface-dark/60 lg:to-surface-dark" />
    <div class="absolute inset-0 bg-gradient-to-t from-surface-dark via-surface-dark/50 to-transparent lg:from-surface-dark/30 lg:via-transparent" />
  </div>

  {/* ── Ambient Light Effects ── */}
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-[10%] right-[5%] w-[500px] h-[500px] rounded-full bg-primary/8 blur-[150px]" />
    <div class="absolute bottom-[15%] right-[20%] w-[400px] h-[400px] rounded-full bg-accent/6 blur-[120px]" />
  </div>

  {/* ── Content: Right Side ── */}
  <div class="relative z-10 mx-auto flex min-h-[100dvh] max-w-7xl items-center px-4 sm:px-6 lg:px-8">
    <div class="ml-auto w-full lg:w-[55%] xl:w-[50%]">
      <HeroContent
        client:load
        tagline={tagline}
        title={title}
        subtitle={subtitle}
        role={role}
        primaryCta={primaryCta}
        secondaryCta={secondaryCta}
        primaryHref={getRelativeLocaleUrl(lang, '/properties')}
        secondaryHref={getRelativeLocaleUrl(lang, '/#appointment')}
      />
    </div>
  </div>

  {/* ── Floating Realtor Card Accent ── */}
  <div class="absolute bottom-8 left-8 z-20 hidden lg:block animate-float">
    <div class="relative">
      <img
        src="/images/realtor-card.png"
        alt="Realtor Card"
        class="w-48 xl:w-56 object-contain drop-shadow-[0_20px_40px_rgba(0,0,0,0.5)] rounded-xl transition-transform duration-500 hover:scale-105"
      />
      <img
        src="/images/realstate.png"
        alt=""
        class="absolute -top-6 -right-6 w-14 opacity-25 rotate-12 pointer-events-none"
        aria-hidden="true"
      />
    </div>
  </div>

  {/* ── Bottom Bar: Badge + Scroll ── */}
  <div class="absolute bottom-0 left-0 right-0 z-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-6 flex items-end justify-between">
      {/* Stats Badge */}
      <div class="hidden md:flex lg:hidden items-center gap-3 bg-white/90 backdrop-blur-lg rounded-2xl px-5 py-3 shadow-2xl border border-white/60">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-accent text-white">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
          </svg>
        </div>
        <div>
          <p class="font-bold text-sm text-on-surface leading-tight" data-edit-key="hero.badgeTitle">{badgeTitle}</p>
          <p class="text-[11px] font-semibold text-primary uppercase tracking-wider" data-edit-key="hero.badgeDesc">{badgeDesc}</p>
        </div>
      </div>

      {/* Scroll Indicator */}
      <div class="hidden md:flex flex-col items-center gap-1.5 text-white/40 ml-auto animate-bounce-slow">
        <span class="text-[9px] uppercase tracking-[0.3em] font-medium">Scroll</span>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section img[alt=""] { font-size: 0; }
  @keyframes bounce-slow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  .animate-bounce-slow { animation: bounce-slow 2.5s ease-in-out infinite; }
</style>
