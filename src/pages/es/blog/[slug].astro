---
import BaseLayout from '../../../components/layout/BaseLayout.astro'
import PublicLayout from '../../../components/layout/PublicLayout.astro'
import { useTranslations } from '../../../i18n/utils'
import { db } from '../../../lib/db'
import { blogPosts } from '../../../db/schema'
import { eq } from 'drizzle-orm'
const { slug } = Astro.params
if (!slug) return Astro.redirect('/es/blog')
const [post] = await db.select().from(blogPosts).where(eq(blogPosts.slug, slug)).limit(1)
if (!post || !post.published) return Astro.redirect('/es/blog')
const t = useTranslations('es')
const content = post.contentEs ?? post.contentEn ?? ''
---
<BaseLayout title={post.titleEs} description={post.excerptEs ?? post.titleEs} lang="es" image={post.coverImage ?? undefined}>
  <PublicLayout lang="es" t={t}>
    <article class="mx-auto max-w-3xl px-4 py-8">
      <a href="/es/blog" class="text-sm text-brand-600 hover:underline">← Blog</a>
      {post.coverImage && <img src={post.coverImage} alt="" class="mt-4 aspect-video w-full rounded-lg object-cover" />}
      <h1 class="mt-6 text-3xl font-bold text-gray-900">{post.titleEs}</h1>
      {post.excerptEs && <p class="mt-2 text-lg text-gray-600">{post.excerptEs}</p>}
      <div class="prose prose-gray mt-8 max-w-none" set:html={content} />
    </article>
  </PublicLayout>
</BaseLayout>
