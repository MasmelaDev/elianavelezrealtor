---
import BaseLayout from '../../components/layout/BaseLayout.astro'
import PublicLayout from '../../components/layout/PublicLayout.astro'
import HeroSection from '../../components/sections/HeroSection.astro'
import StatsSection from '../../components/sections/StatsSection.astro'
import WhyChooseSection from '../../components/sections/WhyChooseSection.astro'
import AboutSection from '../../components/sections/AboutSection.astro'
import ServicesSection from '../../components/sections/ServicesSection.astro'
import { getLangFromUrl, useTranslations } from '../../i18n/utils'
import { db } from '../../lib/db'
import { pageContent } from '../../db/schema'
import { eq } from 'drizzle-orm'
import FeaturedProperties from '../../components/sections/FeaturedProperties'
import ContactForm from '../../components/sections/ContactForm'
import TestimonialsContent from '../../components/sections/TestimonialsContent'
import { ZoneMap } from '../../components/sections/ZoneMap'
import AppointmentForm from '../../components/sections/AppointmentForm'
import { properties } from '../../db/schema'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const contentRows = await db.select().from(pageContent)
const content: Record<string, { en: string; es: string }> = {}
contentRows.forEach((r) => { content[r.key] = { en: r.valueEn, es: r.valueEs } })

const heroTitle = content['hero.title']?.en ?? 'Find Your Perfect Home'
const heroSubtitle = content['hero.subtitle']?.en ?? 'Turning your vision into reality. Your expert real estate guide.'
const heroTagline = content['hero.tagline']?.en ?? t('hero.tagline')
const heroRole = content['hero.role']?.en ?? t('hero.role')
const heroCtaPrimary = content['hero.cta.primary']?.en ?? t('hero.cta.primary')
const heroCtaSecondary = content['hero.cta.secondary']?.en ?? t('hero.cta.secondary')
const heroBadgeTitle = content['hero.badgeTitle']?.en ?? t('hero.badgeTitle')
const heroBadgeDesc = content['hero.badgeDesc']?.en ?? t('hero.badgeDesc')
const aboutTitle = content['about.title']?.en ?? t('about.title')
const aboutBody = content['about.body']?.en ?? 'I am Eliana Velez, a passionate real estate professional with a proven track record of helping families and investors find their perfect place. My commitment is to provide you with transparent, agile, and fully personalized service to ensure the absolute success of your investment and your peace of mind.'
const aboutBadge = content['about.badge']?.en ?? t('about.badge')
const aboutCta = content['about.cta']?.en ?? t('about.cta')
const aboutHappyClients = content['about.happyClients']?.en ?? t('about.happyClients')
const servicesTitle = content['services.title']?.en ?? t('services.title')
const servicesBody = content['services.body']?.en ?? 'Whether you are looking for your dream home, want to sell your property at the best price in today’s competitive market, or seek a profitable rental investment, I offer comprehensive and dedicated guidance every step of the way.'

const servicesBadge = content['services.badge']?.en ?? t('services.badge')
const servicesBuyTitle = content['services.buy.title']?.en ?? t('services.buy.title')
const servicesBuyDesc = content['services.buy.desc']?.en ?? t('services.buy.desc')
const servicesSellTitle = content['services.sell.title']?.en ?? t('services.sell.title')
const servicesSellDesc = content['services.sell.desc']?.en ?? t('services.sell.desc')
const servicesRentTitle = content['services.rent.title']?.en ?? t('services.rent.title')
const servicesRentDesc = content['services.rent.desc']?.en ?? t('services.rent.desc')
const whyTitle = content['why.title']?.en ?? t('why.title')
const whySubtitle = content['why.subtitle']?.en ?? t('why.subtitle')
const whyItem1Title = content['why.item1.title']?.en ?? t('why.item1.title')
const whyItem1Desc = content['why.item1.desc']?.en ?? t('why.item1.desc')
const whyItem2Title = content['why.item2.title']?.en ?? t('why.item2.title')
const whyItem2Desc = content['why.item2.desc']?.en ?? t('why.item2.desc')
const whyItem3Title = content['why.item3.title']?.en ?? t('why.item3.title')
const whyItem3Desc = content['why.item3.desc']?.en ?? t('why.item3.desc')
const whyIcon1 = (content['why.item1.icon']?.en ?? '').trim() || undefined
const whyIcon2 = (content['why.item2.icon']?.en ?? '').trim() || undefined
const whyIcon3 = (content['why.item3.icon']?.en ?? '').trim() || undefined
const contactTitle = content['contact.title']?.en ?? t('contact.title')
const statsYears = content['stats.years']?.en ?? t('stats.years')
const statsYearsLabel = content['stats.yearsLabel']?.en ?? t('stats.yearsLabel')
const statsClients = content['stats.clients']?.en ?? t('stats.clients')
const statsClientsLabel = content['stats.clientsLabel']?.en ?? t('stats.clientsLabel')
const statsDeals = content['stats.deals']?.en ?? t('stats.deals')
const statsDealsLabel = content['stats.dealsLabel']?.en ?? t('stats.dealsLabel')
const aboutBadgeFloatingTitle = content['about.badgeFloatingTitle']?.en ?? 'Certified'
const aboutBadgeFloatingDesc = content['about.badgeFloatingDesc']?.en ?? 'Top Realtor'
const testimonialsTitle = content['testimonials.title']?.en ?? t('testimonials.title')
const testimonialsSubtitle = content['testimonials.subtitle']?.en ?? t('testimonials.subtitle')

const heroImage = content['image.hero']?.en ?? '/images/elianafull.jpg'
const aboutImage = content['image.about']?.en ?? '/images/elianafull.jpg'
const serviceBuyImage = content['image.service.buy']?.en ?? '/images/hero-bg.png'
const serviceSellImage = content['image.service.sell']?.en ?? '/images/hero-2.png'
const serviceRentImage = content['image.service.rent']?.en ?? '/images/hero-3.png'
const iconBuy = (content['icon.service.buy']?.en ?? '').trim() || undefined
const iconSell = (content['icon.service.sell']?.en ?? '').trim() || undefined
const iconRent = (content['icon.service.rent']?.en ?? '').trim() || undefined

const buildTestimonials = (langKey: 'es' | 'en') => [
  { id: '1', name: content['testimonials.1.name']?.[langKey] ?? '', role: content['testimonials.1.role']?.[langKey] ?? '', content: content['testimonials.1.content']?.[langKey] ?? '', image: content['testimonials.1.image']?.en ?? '', rating: Math.min(5, Math.max(1, parseInt(content['testimonials.1.rating']?.en ?? '5', 10) || 5)) },
  { id: '2', name: content['testimonials.2.name']?.[langKey] ?? '', role: content['testimonials.2.role']?.[langKey] ?? '', content: content['testimonials.2.content']?.[langKey] ?? '', image: content['testimonials.2.image']?.en ?? '', rating: Math.min(5, Math.max(1, parseInt(content['testimonials.2.rating']?.en ?? '5', 10) || 5)) },
  { id: '3', name: content['testimonials.3.name']?.[langKey] ?? '', role: content['testimonials.3.role']?.[langKey] ?? '', content: content['testimonials.3.content']?.[langKey] ?? '', image: content['testimonials.3.image']?.en ?? '', rating: Math.min(5, Math.max(1, parseInt(content['testimonials.3.rating']?.en ?? '5', 10) || 5)) },
]
const enTestimonialsRaw = buildTestimonials('en')
const enTestimonials = enTestimonialsRaw.some(t => t.name || t.content) ? enTestimonialsRaw : [
  { id: '1', name: 'Sarah Jenkins', role: 'Homebuyer', content: 'Eliana was incredible! She guided us through every step of buying our first home.', image: '/images/sarah.jpg', rating: 5 },
  { id: '2', name: 'Michael Chen', role: 'Property Investor', content: 'I have worked with many realtors, but the level of professionalism here is unmatched.', image: '/images/michael.jpg', rating: 5 },
  { id: '3', name: 'Elena Rodriguez', role: 'Home Seller', content: 'Selling a house can be stressful, but she made it seamless. My house sold over asking price within a week!', image: '/images/elena.jpg', rating: 5 },
]

const propsList = await db.select({
  id: properties.id,
  titleEn: properties.titleEn,
  titleEs: properties.titleEs,
  price: properties.price,
  lat: properties.lat,
  lng: properties.lng
}).from(properties).where(eq(properties.status, 'sold'))
---
<BaseLayout title="Eliana Velez Realtor" description={heroSubtitle} lang="en">
  <PublicLayout lang="en" t={t} transparentNav={true} editorMode={Astro.url.searchParams.get('editor') === 'true'}>
    <HeroSection
      lang="en"
      t={t}
      title={heroTitle}
      subtitle={heroSubtitle}
      heroImage={heroImage}
      tagline={heroTagline}
      role={heroRole}
      primaryCta={heroCtaPrimary}
      secondaryCta={heroCtaSecondary}
      badgeTitle={heroBadgeTitle}
      badgeDesc={heroBadgeDesc}
    />
    <StatsSection t={t} years={statsYears} yearsLabel={statsYearsLabel} clients={statsClients} clientsLabel={statsClientsLabel} deals={statsDeals} dealsLabel={statsDealsLabel} />
    <FeaturedProperties
      client:load
      lang="en"
      featuredTitle={t('properties.featuredTitle')}
      viewAll={t('properties.viewAll')}
      emptyFeatured={t('properties.emptyFeatured')}
      typeSale={t('filter.type.sale')}
      typeRent={t('filter.type.rent')}
    />
    <WhyChooseSection
      t={t}
      whyTitle={whyTitle}
      whySubtitle={whySubtitle}
      item1Title={whyItem1Title}
      item1Desc={whyItem1Desc}
      item2Title={whyItem2Title}
      item2Desc={whyItem2Desc}
      item3Title={whyItem3Title}
      item3Desc={whyItem3Desc}
      icon1={whyIcon1}
      icon2={whyIcon2}
      icon3={whyIcon3}
    />
    <AboutSection lang="en" t={t} title={aboutTitle} body={aboutBody} badge={aboutBadge} cta={aboutCta} happyClients={aboutHappyClients} badgeFloatingTitle={aboutBadgeFloatingTitle} badgeFloatingDesc={aboutBadgeFloatingDesc} cardImage={aboutImage} />
    <ServicesSection lang="en" t={t} title={servicesTitle} badge={servicesBadge} body={servicesBody} serviceImages={[serviceBuyImage, serviceSellImage, serviceRentImage]} buyTitle={servicesBuyTitle} buyDesc={servicesBuyDesc} sellTitle={servicesSellTitle} sellDesc={servicesSellDesc} rentTitle={servicesRentTitle} rentDesc={servicesRentDesc} iconBuy={iconBuy} iconSell={iconSell} iconRent={iconRent} />
    <TestimonialsContent
      client:load
      title={testimonialsTitle}
      subtitle={testimonialsSubtitle}
      testimonials={enTestimonials}
    />
    <ContactForm client:load lang="en" contactTitle={contactTitle} whatsappNumber={content['contact.whatsapp']?.en} />
  </PublicLayout>
</BaseLayout>
