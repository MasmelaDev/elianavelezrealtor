---
import AdminLayout from '../../../components/admin/AdminLayout.astro'
import { db } from '../../../lib/db'
import { properties } from '../../../db/schema'
import { desc } from 'drizzle-orm'
import { PropertiesTable } from '../../../components/admin/PropertiesTable'
const list = await db.select().from(properties).orderBy(desc(properties.createdAt))
---
<AdminLayout title="Propiedades">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-gray-900">Propiedades</h1>
    <a href="/admin/properties/new" class="rounded bg-gray-800 px-4 py-2 text-sm text-white hover:bg-gray-700">Nueva propiedad</a>
  </div>
  <div class="mt-4">
    <PropertiesTable client:load data={list as any} />
  </div>
</AdminLayout>
