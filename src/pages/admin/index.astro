---
import AdminLayout from '../../components/admin/AdminLayout.astro'
import { db } from '../../lib/db'
import { properties, leads, appointments, blogPosts } from '../../db/schema'
import { sql } from 'drizzle-orm'

const [propsCount] = await db.select({ count: sql<number>`count(*)` }).from(properties)
const [leadsCount] = await db.select({ count: sql<number>`count(*)` }).from(leads)
const [apptsCount] = await db.select({ count: sql<number>`count(*)` }).from(appointments)
const [postsCount] = await db.select({ count: sql<number>`count(*)` }).from(blogPosts)
const metrics = {
  properties: Number(propsCount?.count ?? 0),
  leads: Number(leadsCount?.count ?? 0),
  appointments: Number(apptsCount?.count ?? 0),
  blogPosts: Number(postsCount?.count ?? 0),
}

import { desc } from 'drizzle-orm'
const recentLeads = await db.select().from(leads).orderBy(desc(leads.createdAt)).limit(5)
---
<AdminLayout title="Dashboard">
  <p class="text-gray-500 mb-6">Bienvenido al panel de administración.</p>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Propiedades -->
    <a href="/admin/properties" class="group relative overflow-hidden rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition-all hover:shadow-md hover:border-gray-300">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">Propiedades</p>
          <p class="mt-1 text-3xl font-bold text-gray-900">{metrics.properties}</p>
        </div>
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-600 transition-colors group-hover:bg-blue-100">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
        </div>
      </div>
    </a>

    <!-- Leads -->
    <a href="/admin/leads" class="group relative overflow-hidden rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition-all hover:shadow-md hover:border-gray-300">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">Leads</p>
          <p class="mt-1 text-3xl font-bold text-gray-900">{metrics.leads}</p>
        </div>
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 transition-colors group-hover:bg-emerald-100">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
        </div>
      </div>
    </a>

    <!-- Citas -->
    <a href="/admin/appointments" class="group relative overflow-hidden rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition-all hover:shadow-md hover:border-gray-300">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">Citas</p>
          <p class="mt-1 text-3xl font-bold text-gray-900">{metrics.appointments}</p>
        </div>
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-50 text-amber-600 transition-colors group-hover:bg-amber-100">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
        </div>
      </div>
    </a>

    <!-- Blog -->
    <a href="/admin/blog" class="group relative overflow-hidden rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition-all hover:shadow-md hover:border-gray-300">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">Posts del blog</p>
          <p class="mt-1 text-3xl font-bold text-gray-900">{metrics.blogPosts}</p>
        </div>
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-purple-50 text-purple-600 transition-colors group-hover:bg-purple-100">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
        </div>
      </div>
    </a>
  </div>

  <div class="mt-10">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-bold text-gray-900">Leads Recientes</h2>
      <a href="/admin/leads" class="text-sm font-semibold text-brand-600 hover:text-brand-700">Ver todos</a>
    </div>
    <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
      <table class="w-full text-left text-sm">
        <thead class="bg-gray-50/50 border-b border-gray-100">
          <tr>
            <th class="px-6 py-3 font-semibold text-gray-900">Cliente</th>
            <th class="px-6 py-3 font-semibold text-gray-900">Origen</th>
            <th class="px-6 py-3 font-semibold text-gray-900">Fecha</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          {recentLeads.length === 0 ? (
            <tr>
              <td colspan="3" class="px-6 py-8 text-center text-gray-500 italic">No hay leads registrados aún.</td>
            </tr>
          ) : (
            recentLeads.map((lead) => (
              <tr class="hover:bg-gray-50/50 transition-colors">
                <td class="px-6 py-4">
                  <div class="font-medium text-gray-900">{lead.name}</div>
                  <div class="text-xs text-gray-500">{lead.email}</div>
                </td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center rounded-full bg-blue-50 px-2 py-0.5 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10">
                    {lead.source}
                  </span>
                </td>
                <td class="px-6 py-4 text-gray-500 text-xs">
                  {lead.createdAt ? new Date(lead.createdAt).toLocaleDateString() : '—'}
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
