---
import AdminLayout from '../../components/admin/AdminLayout.astro'
import { db } from '../../lib/db'
import { appointments, leads, availabilitySlots } from '../../db/schema'
import { desc, eq } from 'drizzle-orm'
import { AppointmentsTable } from '../../components/admin/AppointmentsTable'
const data = await db
  .select({
    id: appointments.id,
    status: appointments.status,
    createdAt: appointments.createdAt,
    leadName: leads.name,
    leadEmail: leads.email,
    leadPhone: leads.phone,
    slotDate: availabilitySlots.date,
    slotTimeStart: availabilitySlots.timeStart,
    slotTimeEnd: availabilitySlots.timeEnd,
  })
  .from(appointments)
  .innerJoin(leads, eq(appointments.leadId, leads.id))
  .innerJoin(availabilitySlots, eq(appointments.slotId, availabilitySlots.id))
  .orderBy(desc(appointments.createdAt))
---
<AdminLayout title="Citas">
  <div class="mt-2">
    <AppointmentsTable client:load data={data as any} />
  </div>
</AdminLayout>
