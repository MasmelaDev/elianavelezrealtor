---
import AdminLayout from '../../components/admin/AdminLayout.astro'
import { db } from '../../lib/db'
import { availabilitySlots } from '../../db/schema'
import { desc } from 'drizzle-orm'
import { Calendar, Clock, Plus, Trash2, CheckCircle2, Clock as ClockIcon } from 'lucide-react'

const list = await db.select().from(availabilitySlots).orderBy(desc(availabilitySlots.date), desc(availabilitySlots.timeStart))
---
<AdminLayout title="Disponibilidad">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900">Agenda de Disponibilidad</h1>
    <p class="text-sm text-gray-500">Crea y gestiona los bloques de horario para citas con tus clientes.</p>
  </div>

  <div class="grid gap-8 lg:grid-cols-3">
    <!-- Form Side -->
    <div class="lg:col-span-1">
      <div class="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5">
        <div class="border-b border-gray-900/10 bg-gray-50/50 px-6 py-4 flex items-center gap-3">
          <div class="rounded-lg bg-white p-2 shadow-sm ring-1 ring-gray-900/10">
            <Plus className="h-4 w-4 text-brand-600" />
          </div>
          <h2 class="text-sm font-semibold text-gray-900">Nuevo Horario</h2>
        </div>
        <form id="add-slot" class="p-6 space-y-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Fecha</label>
            <input type="date" name="date" required class="block w-full rounded-md border-0 py-2 px-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-brand-600 sm:text-sm" />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Inicio</label>
              <input type="time" name="timeStart" required class="block w-full rounded-md border-0 py-2 px-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-brand-600 sm:text-sm" />
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-gray-500 mb-1">Fin</label>
              <input type="time" name="timeEnd" required class="block w-full rounded-md border-0 py-2 px-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-brand-600 sm:text-sm" />
            </div>
          </div>
          <button type="submit" class="w-full flex items-center justify-center gap-2 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 transition-colors">
            <Plus className="h-4 w-4" />
            Añadir Bloque
          </button>
        </form>
      </div>
    </div>

    <!-- Table Side -->
    <div class="lg:col-span-2">
      <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="border-b border-gray-100 bg-gray-50/50">
                <th class="px-6 py-4 font-semibold text-gray-900">Fecha</th>
                <th class="px-6 py-4 font-semibold text-gray-900">Horario</th>
                <th class="px-6 py-4 font-semibold text-gray-900">Estado</th>
                <th class="px-6 py-4 font-semibold text-gray-900 text-right"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
              {list.length === 0 ? (
                <tr>
                  <td colspan="4" class="px-6 py-12 text-center text-gray-500 italic">No hay bloques de horario creados aún.</td>
                </tr>
              ) : (
                list.map((slot) => {
                  const dateStr = typeof slot.date === 'string' ? slot.date : (slot.date as Date).toISOString().slice(0, 10)
                  const start = typeof slot.timeStart === 'string' ? String(slot.timeStart).slice(0, 5) : '—'
                  const end = typeof slot.timeEnd === 'string' ? String(slot.timeEnd).slice(0, 5) : '—'
                  return (
                    <tr class="hover:bg-gray-50 transition-colors">
                      <td class="px-6 py-4">
                        <div class="flex items-center gap-2 text-gray-900 font-medium">
                          <Calendar className="h-4 w-4 text-gray-400" />
                          {dateStr}
                        </div>
                      </td>
                      <td class="px-6 py-4">
                        <div class="flex items-center gap-2 text-gray-600 font-mono text-xs">
                          <ClockIcon className="h-4 w-4 text-gray-400" />
                          {start} - {end}
                        </div>
                      </td>
                      <td class="px-6 py-4">
                        {slot.isBooked ? (
                          <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-2 py-1 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-600/20">
                            <ClockIcon className="h-3 w-3" />
                            Reservado
                          </span>
                        ) : (
                          <span class="inline-flex items-center gap-1.5 rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">
                            <CheckCircle2 className="h-3 w-3" />
                            Disponible
                          </span>
                        )}
                      </td>
                      <td class="px-6 py-4 text-right">
                        {!slot.isBooked && (
                          <button type="button" data-slot-id={slot.id} class="delete-slot p-2 text-gray-400 hover:text-red-600 transition-colors">
                            <Trash2 className="h-4 w-4" />
                          </button>
                        )}
                      </td>
                    </tr>
                  )
                })
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('add-slot') as HTMLFormElement
    form?.addEventListener('submit', async (e) => {
      e.preventDefault()
      const fd = new FormData(form)
      const res = await fetch('/api/availability', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          date: fd.get('date'),
          timeStart: fd.get('timeStart'),
          timeEnd: fd.get('timeEnd'),
        }),
      })
      if (res.ok) window.location.reload()
    })

    document.querySelectorAll('.delete-slot').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLButtonElement).dataset.slotId
        if (!id || !confirm('¿Estás seguro de que quieres eliminar este horario?')) return
        const res = await fetch(`/api/availability/${id}`, { method: 'DELETE' })
        if (res.ok) window.location.reload()
      })
    })
  </script>
</AdminLayout>
