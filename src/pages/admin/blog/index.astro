---
import AdminLayout from '../../../components/admin/AdminLayout.astro'
import { db } from '../../../lib/db'
import { blogPosts } from '../../../db/schema'
import { desc } from 'drizzle-orm'
import { BlogTable } from '../../../components/admin/BlogTable'
const list = await db.select().from(blogPosts).orderBy(desc(blogPosts.createdAt))
---
<AdminLayout title="Blog">
  <div class="flex items-center justify-end mb-4">
    <a href="/admin/blog/new" class="inline-flex items-center gap-2 rounded-lg bg-[#0F2A3D] px-4 py-2.5 text-sm font-medium text-white shadow-sm transition-colors hover:bg-[#1a3a52]">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
      Nuevo post
    </a>
  </div>
  <div>
    <BlogTable client:load data={list as any} />
  </div>
</AdminLayout>
