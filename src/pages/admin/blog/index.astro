---
import AdminLayout from '../../../components/admin/AdminLayout.astro'
import { db } from '../../../lib/db'
import { blogPosts } from '../../../db/schema'
import { desc } from 'drizzle-orm'
import { BlogTable } from '../../../components/admin/BlogTable'
const list = await db.select().from(blogPosts).orderBy(desc(blogPosts.createdAt))
---
<AdminLayout title="Blog">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-gray-900">Blog</h1>
    <a href="/admin/blog/new" class="rounded bg-gray-800 px-4 py-2 text-sm text-white hover:bg-gray-700">Nuevo post</a>
  </div>
  <div class="mt-4">
    <BlogTable client:load data={list as any} />
  </div>
</AdminLayout>
