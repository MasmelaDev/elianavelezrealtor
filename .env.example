# -----------------------------------------------------------------------------
# ARCHIVO DE CONFIGURACIÓN DE EJEMPLO (.env.example)
# Copia este archivo como .env y rellena los valores con tus credenciales reales.
# -----------------------------------------------------------------------------

# --- BASE DE DATOS (Drizzle + Neon/Postgres) ---
# URL de conexión a PostgreSQL. 
# Si usas Neon.tech, la app usará el driver optimizado por HTTP.
# Local: postgresql://usuario:password@localhost:5432/nombre_db
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- SEGURIDAD Y AUTENTICACIÓN ---
# Secreto para firmar los tokens JWT del panel administrativo.
# Genera uno seguro con: openssl rand -base64 32
JWT_SECRET=tu_secreto_super_seguro_aqui

# --- SERVICIO DE CORREO (Resend) ---
# Obtén tu API Key en https://resend.com
RESEND_API_KEY=re_1234567890abcdef

# El correo donde Eliana recibirá las notificaciones de nuevos leads y citas.
REALTOR_EMAIL=eliana@tudominio.com

# El correo que aparecerá como remitente. Debe estar verificado en Resend.
# Ejemplo: no-reply@elianavelezrealtor.com
RESEND_FROM=noreply@elianavelezrealtor.com

# --- ALMACENAMIENTO DE IMÁGENES (Cloudinary) ---
# Necesario para la subida de fotos de propiedades y blog.
# Regístrate en https://cloudinary.com
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# --- MAPAS INTERACTIVOS (Mapbox) ---
# Token público para mostrar el mapa en la landing y detalles de propiedad.
# Empieza por PUBLIC_ para que Astro lo exponga al navegador.
# Consíguelo en https://mapbox.com
PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VyIiwiYSI6ImNseHh4eHh4eHh4In0.xxxxxxx

# --- CONFIGURACIÓN DE LA APP ---
# URL base del sitio en producción. Se usa para SEO y enlaces absolutos en correos.
PUBLIC_SITE_URL=https://elianavelezrealtor.com
